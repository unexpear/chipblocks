{
  "name": "gerber-layers",
  "title": "Gerber check: every layer tab (aria-pressed + its own counts line and FileFunction), Stack, zoom, toggle off",
  "covers": ["pcbPanel", "gerberCheck"],
  "steps": [
    {
      "id": "create-led",
      "title": "LED + resistor template",
      "screen": "workspace",
      "do": {
        "macro": "newProject",
        "with": {
          "category": "start.circuit",
          "template": "start.tplLed"
        }
      },
      "expect": [
        {
          "type": "text",
          "region": "workspace.status",
          "matches": "— 4 components, 4 wires",
          "id": "status-4c-4w"
        }
      ]
    },
    {
      "id": "open-gerber",
      "title": "Check Gerbers (tall window)",
      "screen": ["pcbPanel", "gerberCheck"],
      "do": {
        "open": "gerberCheck"
      },
      "expect": [
        {
          "type": "visible",
          "sel": "gerberCheck.plot",
          "id": "plot-drawn"
        },
        {
          "type": "absent",
          "sel": "gerberCheck.refusal",
          "id": "refusal-absent"
        }
      ]
    },
    {
      "id": "tab-board-F_Cu.gtl",
      "title": "board-F_Cu.gtl: tab shows its own counts line and FileFunction",
      "screen": "gerberCheck",
      "continueOnFail": true,
      "do": {
        "click": "gerberCheck.tab",
        "with": {
          "file": "board-F_Cu.gtl"
        }
      },
      "expect": [
        {
          "type": "pressed",
          "sel": {
            "testid": "gerber-layer-tab",
            "textIs": "board-F_Cu.gtl"
          },
          "value": "true",
          "id": "tab-pressed"
        },
        {
          "type": "count",
          "sel": {
            "css": "[data-testid=\"gerber-layer-tab\"][aria-pressed=\"true\"]"
          },
          "eq": 1,
          "id": "exactly-one-pressed"
        },
        {
          "type": "numbers",
          "region": "gerberCheck.counts",
          "re": "^(\\d+) flash(?:es)? · (\\d+) strokes? · (\\d+) drills?",
          "check": [
            {
              "op": "gt",
              "a": "$1",
              "b": 0
            }
          ],
          "id": "counts-line"
        },
        {
          "type": "text",
          "region": "gerberCheck.counts",
          "matches": "Copper,L1,Top · Positive",
          "id": "file-function"
        },
        {
          "type": "absent",
          "sel": "gerberCheck.refusal",
          "id": "refusal-absent"
        }
      ]
    },
    {
      "id": "tab-board-B_Cu.gbl",
      "title": "board-B_Cu.gbl: tab shows its own counts line and FileFunction",
