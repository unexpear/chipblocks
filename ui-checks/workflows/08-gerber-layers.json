    {
      "id": "stack",
      "title": "Stack returns to all layers in one frame",
      "screen": "gerberCheck",
      "do": {
        "click": "gerberCheck.stack"
      },
      "expect": [
        {
          "type": "text",
          "region": "gerberCheck",
          "matches": "All plotted layers, one frame\\.",
          "id": "stack-mode"
        },
        {
          "type": "visible",
          "sel": {
            "testid": "gerber-board"
          },
          "id": "board-drawn-in-stack"
        },
        {
          "type": "count",
          "sel": {
            "css": "[data-testid=\"gerber-layer-tab\"][aria-pressed=\"true\"]"
          },
          "eq": 0,
          "id": "no-tab-pressed"
        }
      ]
    },
    {
      "id": "zoom-in",
      "title": "+ zooms in (plot gets wider)",
      "screen": "gerberCheck",
      "do": [
        {
          "capture": {
            "name": "w0",
            "sel": "gerberCheck.plot",
            "attr": "width"
          }
        },
        {
          "click": "gerberCheck.zoomIn"
        }
      ],
      "expect": [
        {
          "type": "attrNumber",
          "sel": "gerberCheck.plot",
          "name": "width",
          "check": [
            {
              "op": "gt",
              "b": "@w0"
            }
          ],
          "id": "wider"
        }
      ]
    },
    {
      "id": "zoom-out",
      "title": "− zooms back out",
      "screen": "gerberCheck",
      "do": [
        {
          "capture": {
            "name": "w1",
            "sel": "gerberCheck.plot",
            "attr": "width"
          }
        },
        {
          "click": "gerberCheck.zoomOut"
        }
      ],
      "expect": [
        {
          "type": "attrNumber",
          "sel": "gerberCheck.plot",
          "name": "width",
          "check": [
            {
              "op": "lt",
              "b": "@w1"
            }
          ],
          "id": "narrower"
        }
      ]
    },
    {
      "id": "fit",
      "title": "+ twice then Fit restores the fitted width",
      "screen": "gerberCheck",
      "do": [
        {
          "click": "gerberCheck.zoomIn"
        },
        {
          "click": "gerberCheck.zoomIn"
        },
        {
          "click": "gerberCheck.fit"
        }
      ],
      "expect": [
        {
          "type": "attrNumber",
          "sel": "gerberCheck.plot",
          "name": "width",
          "check": [
            {
              "op": "eq",
              "b": "@w0"
            }
          ],
          "id": "fit-width"
        }
      ]
    },
    {
      "id": "toggle-off",
      "title": "Check Gerbers again closes the check",
      "screen": "pcbPanel",
      "do": {
        "click": "pcbPanel.checkGerbers"
      },
      "expect": [
        {
          "type": "absent",
          "sel": "gerberCheck.plot",
          "id": "plot-gone"
        },
        {
          "type": "pressed",
          "sel": "pcbPanel.checkGerbers",
          "value": "false",
          "id": "unpressed"
        }
      ]
    }
  ]
}
