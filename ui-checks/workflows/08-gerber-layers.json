          "check": [
            {
              "op": "ge",
              "a": "$1",
              "b": 0
            }
          ],
          "id": "counts-line"
        },
        {
          "type": "text",
          "region": "gerberCheck.counts",
          "matches": "Copper,L2,Bot · Positive",
          "id": "file-function"
        },
        {
          "type": "absent",
