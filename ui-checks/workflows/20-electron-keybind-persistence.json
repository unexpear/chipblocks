{
  "name": "electron-keybind-persistence",
  "targets": ["electron"],
  "title": "Rebinds are written to userData/keybinds.json, re-label the native menu, and survive a relaunch; Reset restores the defaults",
  "covers": ["shortcuts", "workspace"],
  "steps": [
    {
      "id": "blank",
      "title": "Blank circuit",
      "screen": "workspace",
      "do": {
        "macro": "newProject",
        "with": {
          "category": "start.circuit",
          "template": "start.tplBlankCircuit"
        }
      },
      "expect": [
        {
          "type": "text",
          "region": "workspace.status",
          "matches": "— 0 components, 0 wires",
          "id": "status-0c-0w"
        }
      ]
    },
    {
      "id": "rebind",
      "title": "Rebind Shortcuts panel to Ctrl+J and Rotate to T",
      "screen": "shortcuts",
      "do": [
        {
          "menu": "Shortcuts ▸ View / Change Shortcuts"
        },
        {
          "waitReady": "shortcuts"
        },
        {
          "click": "shortcuts.changeRow",
          "with": {
            "action": "shortcutsPanel"
          }
        },
        {
          "press": "Control+j"
        },
        {
          "waitFor": {
            "type": "attr",
            "sel": {
              "css": "[data-testid=\"shortcut-row\"][data-action=\"shortcutsPanel\"]"
            },
            "name": "data-binding",
            "matches": "^Ctrl\\+J$"
          }
        },
        {
          "click": "shortcuts.changeRow",
          "with": {
            "action": "rotate"
          }
        },
        {
          "press": "t"
        }
      ],
      "expect": [
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"shortcutsPanel\"]"
          },
          "name": "data-binding",
          "matches": "^Ctrl\\+J$",
          "id": "panel-ctrl-j"
        },
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"rotate\"]"
          },
          "name": "data-binding",
          "matches": "^T$",
          "id": "rotate-t"
        },
        {
          "type": "file",
          "path": "{userData}/keybinds.json",
          "json": [
            {
              "at": "shortcutsPanel",
              "eq": "Ctrl+J"
            },
            {
              "at": "rotate",
              "eq": "T"
            }
          ],
          "id": "written"
        },
        {
          "type": "menuItem",
          "path": "Shortcuts ▸ View / Change Shortcuts",
          "id": "menu-relabelled",
          "accelerator": "Ctrl+J"
        }
      ]
    },
    {
      "id": "relaunch",
      "title": "Quit and relaunch on the same sandbox: the panel and the menu still say Ctrl+J and T",
      "screen": "shortcuts",
      "do": [
        {
          "relaunch": true
        },
        {
          "waitReady": "start"
        },
        {
          "macro": "newProject",
          "with": {
            "category": "start.circuit",
            "template": "start.tplBlankCircuit"
          }
        },
        {
          "menu": "Shortcuts ▸ View / Change Shortcuts"
        },
        {
          "waitReady": "shortcuts"
        }
      ],
      "expect": [
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"shortcutsPanel\"]"
          },
          "name": "data-binding",
          "matches": "^Ctrl\\+J$",
          "id": "panel-ctrl-j"
        },
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"rotate\"]"
          },
          "name": "data-binding",
          "matches": "^T$",
          "id": "rotate-t"
        },
        {
          "type": "menuItem",
          "path": "Shortcuts ▸ View / Change Shortcuts",
          "id": "menu-ctrl-j",
          "accelerator": "Ctrl+J"
        }
      ]
    },
    {
      "id": "new-key-works",
      "title": "Close; Ctrl+K no longer opens the panel, Ctrl+J does",
      "screen": "workspace",
      "do": [
        {
          "click": "shortcuts.close"
        },
        {
          "mouseClickAt": {
            "sel": "workspace.canvasArea",
            "dx": 60,
            "dy": 60
          }
        },
        {
          "press": "Control+K"
        },
        {
          "waitFor": {
            "type": "absent",
            "sel": "shortcuts.reset"
          },
          "timeoutMs": 800
        },
        {
          "press": "Control+J"
        }
      ],
      "expect": [
        {
          "type": "visible",
          "sel": "shortcuts.reset",
          "id": "opened-by-ctrl-j"
        }
      ]
    },
    {
      "id": "reset",
      "title": "Reset all to defaults: file and menu back to Ctrl+K / R",
      "screen": "shortcuts",
      "do": {
        "click": "shortcuts.reset"
      },
      "expect": [
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"shortcutsPanel\"]"
          },
          "name": "data-binding",
          "matches": "^Ctrl\\+K$",
          "id": "panel-ctrl-k"
        },
        {
          "type": "file",
          "path": "{userData}/keybinds.json",
          "json": [
            {
              "at": "shortcutsPanel",
              "eq": "Ctrl+K"
            },
            {
              "at": "rotate",
              "eq": "R"
            }
          ],
          "id": "file-reset"
        },
        {
          "type": "menuItem",
          "path": "Shortcuts ▸ View / Change Shortcuts",
          "id": "menu-ctrl-k",
          "accelerator": "Ctrl+K"
        }
      ]
    },
    {
      "id": "defaults-survive-relaunch",
      "title": "Relaunch: defaults stay",
      "screen": "shortcuts",
      "do": [
        {
          "relaunch": true
        },
        {
          "waitReady": "start"
        },
        {
          "menu": "Shortcuts ▸ View / Change Shortcuts"
        },
        {
          "waitReady": "shortcuts"
        }
      ],
      "expect": [
        {
          "type": "attr",
          "sel": {
            "css": "[data-testid=\"shortcut-row\"][data-action=\"shortcutsPanel\"]"
          },
          "name": "data-binding",
          "matches": "^Ctrl\\+K$",
          "id": "panel-ctrl-k"
        },
        {
          "type": "menuItem",
          "path": "Shortcuts ▸ View / Change Shortcuts",
          "id": "menu-ctrl-k",
          "accelerator": "Ctrl+K"
        }
      ]
    }
  ]
}
