{
  "name": "hover-help-screens",
  "title": "Hover help on the meter, scope, timeline, canvas, editors, inspectors, and analysis panels, then it goes away",
  "covers": ["workspace", "start"],
  "steps": [
    {
      "id": "led",
      "title": "LED circuit",
      "screen": "workspace",
      "do": {
        "macro": "newProject",
        "with": { "category": "start.circuit", "template": "start.tplLed" }
      },
      "expect": [
        {
          "type": "text",
          "region": "workspace.status",
          "matches": "— 4 components, 4 wires",
          "id": "led-counts"
        }
      ]
    },
    {
      "id": "canvas-snap",
      "title": "Snap to grid names itself",
      "screen": "workspace",
      "do": [{ "hover": { "role": "button", "name": "Snap to grid", "exact": true } }],
      "expect": [
        { "type": "visible", "sel": { "testid": "tooltip" }, "id": "tip" },
        {
          "type": "text",
          "sel": { "testid": "tooltip-name" },
          "matches": "^Snap to grid$",
          "id": "name"
        },
        { "type": "text", "sel": { "testid": "tooltip-summary" }, "matches": ".+", "id": "summary" }
      ]
    },
    {
      "id": "canvas-snap-out",
      "title": "The snap tip goes away",
      "screen": "workspace",
      "do": [{ "mouseMove": { "x": 1100, "y": 12 } }],
      "expect": [{ "type": "absent", "sel": { "testid": "tooltip" }, "id": "gone" }]
    },
    {
      "id": "close-project",
      "title": "Close project names itself",
      "screen": "workspace",
      "do": [{ "hover": "workspace.closeTab" }],
      "expect": [
        { "type": "visible", "sel": { "testid": "tooltip" }, "id": "tip" },
        {
          "type": "text",
          "sel": { "testid": "tooltip-name" },
          "matches": "^Close project$",
          "id": "name"
        },
        { "type": "text", "sel": { "testid": "tooltip-summary" }, "matches": ".+", "id": "summary" }
      ]
    },
    {
      "id": "close-project-out",
      "title": "The close tip goes away",
      "screen": "workspace",
      "do": [{ "mouseMove": { "x": 1100, "y": 12 } }],
      "expect": [{ "type": "absent", "sel": { "testid": "tooltip" }, "id": "gone" }]
    },
    {
      "id": "device-pin",
      "title": "A part terminal names itself",
      "screen": "workspace",
      "do": [{ "hover": { "css": ".react-flow__handle" } }],
      "expect": [
        { "type": "visible", "sel": { "testid": "tooltip" }, "id": "tip" },
        { "type": "text", "sel": { "testid": "tooltip-name" }, "matches": ".+", "id": "name" },
        { "type": "text", "sel": { "testid": "tooltip-summary" }, "matches": ".+", "id": "summary" }
      ]
    },
    {
      "id": "device-pin-out",
      "title": "The terminal tip goes away",
      "screen": "workspace",
      "do": [{ "mouseMove": { "x": 1100, "y": 12 } }],
      "expect": [{ "type": "absent", "sel": { "testid": "tooltip" }, "id": "gone" }]
    },
    {
      "id": "hierarchy",
      "title": "A hierarchy row names the part",
      "screen": "workspace",
      "do": [
        { "click": { "css": "[data-dock-tab=\"hierarchy\"]" } },
        { "hover": { "css": "[data-definition=\"resistor\"]" } }
      ],
      "expect": [
        { "type": "visible", "sel": { "testid": "tooltip" }, "id": "tip" },
        { "type": "text", "sel": { "testid": "tooltip-name" }, "matches": ".+", "id": "name" },
        { "type": "text", "sel": { "testid": "tooltip-summary" }, "matches": ".+", "id": "summary" }
      ]
    },
    {
      "id": "hierarchy-out",
