.device 384 8 10 8294
.net 39
0 1 logic_op_rgt_0
0 2 logic_op_bnr_0
1 0 logic_op_top_0
1 1 lutff_0/out
1 2 neigh_op_bot_0
2 0 logic_op_tnl_0
2 1 neigh_op_lft_0
2 2 neigh_op_bnl_0
.net 1057
1 1 local_g0_0
.net 1121
1 1 lutff_5/in_1
.buffer 1 1 1057 B0[14] B1[14] B1[15] B1[16] B1[17]
