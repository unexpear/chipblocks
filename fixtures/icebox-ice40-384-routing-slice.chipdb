#   ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
#   OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.
#
.device 384 8 10 8294
.net 2246
2 0 logic_op_tnr_2
2 1 neigh_op_rgt_2
2 2 neigh_op_bnr_2
3 0 logic_op_top_2
3 1 lutff_2/out
3 2 neigh_op_bot_2
4 0 logic_op_tnl_2
4 1 neigh_op_lft_2
4 2 neigh_op_bnl_2
.net 76
0 1 span12_horz_7
1 1 sp12_h_r_8
2 1 sp12_h_r_11
3 1 sp12_h_r_12
4 1 sp12_h_r_15
5 1 sp12_h_r_16
6 1 sp12_h_r_19
7 1 span12_horz_19
.net 122
0 1 span4_horz_5
1 1 sp4_h_r_16
2 1 sp4_h_r_29
3 1 sp4_h_r_40
4 1 sp4_h_l_40
.buffer 3 1 76 B4[47]
1 2246
.buffer 1 1 122 B0[2]
1 76
