{
  "name": "chipblocks",
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "description": "ChipBlocks — visual chip-design app (frontend, Electron + React + TypeScript). Scaffolded from electron-vite-react boilerplate.",
  "author": "unexpear",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/unexpear/chipblocks.git"
  },
  "debug": {
    "env": {
      "VITE_DEV_SERVER_URL": "http://127.0.0.1:7777/"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder --publish=never",
    "preview": "vite preview",
    "test": "vitest run",
    "codegen": "node ../scripts/codegen-frontend.mjs && python3 ../scripts/codegen-backend.py && python3 ../scripts/codegen-shuttles-backend.py",
    "codegen:write": "node ../scripts/codegen-frontend.mjs --write && python3 ../scripts/codegen-backend.py --write && python3 ../scripts/codegen-shuttles-backend.py --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@xyflow/react": "^12.10.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.20",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "jsdom": "^26.1.0",
    "js-yaml": "^4.1.0",
    "postcss": "^8.4.49",
    "postcss-import": "^16.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.0",
    "typescript": "^5.4.2",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^3.0.0"
  }
}
