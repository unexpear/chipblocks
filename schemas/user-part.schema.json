{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chipblocks.example/schemas/user-part.schema.json",
  "title": "UserPart",
  "description": "A user-authored custom part as persisted in a project file (and later a user-local library). It is a BLACK BOX drawn from a pin spec — deliberately NOT a full catalog Definition: a built-in primitive_device (see definition.schema.json) must declare its internal composition (what it is physically built from), which a custom part does not have yet. Faking one to pass the definition schema would violate the anti-placeholder rule. So a user part gets its own schema, validated with the same engine + strictness the catalog uses; when the user later gives it real internals/behaviours it can graduate to definition.schema.json. Values are the user's own, so (per OBJECT-MODEL.md §12, origin project/user_local) no provenance is required — but everything is typed and unit-valid. NOTE: the runtime loader (user-part-validate.ts) enforces two extra rules JSON Schema can't express, both in the stricter/safe direction, so it may reject a part this schema accepts: (1) pin ids must be UNIQUE within the part (JSON Schema's uniqueItems can't key on a field), and (2) a parameter amount must be FINITE (an overflow literal like 1e400 parses to Infinity, which is a valid JSON number but poisons downstream math). The drawn `symbol` is the one place it goes the other way: a drawing that breaks a rule (its own extra rules are listed on $defs/drawnSymbol) is set aside and the rest of the part still loads, because losing a picture must never cost a working part.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_]*[a-z0-9])?$",
      "description": "The definition id — the slug of the name; lowercase alphanumerics + underscores, no leading/trailing underscore. Unique; must not collide with a built-in id (enforced at registration, not here)."
    },
    "name": { "type": "string", "minLength": 1 },
    "designatorPrefix": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "The reference-designator letters — U for a chip, J for a connector, etc."
    },
    "description": { "type": "string" },
    "datasheet": {
      "type": "string",
      "description": "Where the part's datasheet lives — a link or a document name. It is the text of the drawn symbol's Datasheet field. A blank one is dropped on load (none given)."
    },
    "footprintId": {
      "type": "string",
      "minLength": 1,
      "description": "The board package this part lands on (a BUILTIN_FOOTPRINTS id); pins map to its pads in declaration order. Absent ⇒ no footprint yet, so the part stays off the board."
    },
    "pins": {
      "type": "array",
      "minItems": 1,
      "description": "The connection points. Each becomes a wire handle + a terminal name.",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "side": { "enum": ["left", "right", "top", "bottom"] },
          "electrical": {
            "enum": [
              "input",
              "output",
              "bidirectional",
              "passive",
              "power_in",
              "power_out",
              "unspecified"
            ]
          },
          "pad": {
            "type": "string",
            "description": "The footprint pad this pin solders to, named as the package labels it ('1', 'A5'). Absent or blank ⇒ matched by the pin's name, then by declaration order."
          }
        },
        "required": ["id", "name", "side", "electrical"],
        "additionalProperties": false
      }
    },
    "symbol": {
      "$ref": "#/$defs/drawnSymbol",
      "description": "Optional DRAWN schematic symbol — the picture the part's author drew, in place of the plain labelled box its pins imply. Presentation only: pin names, pads and electrical roles stay on `pins`, and the solver never reads it. Each pin points out of its own `side`."
    },
    "behavesAs": {
      "type": "object",
      "description": "Optional REAL, simulatable behaviour (slice 4b): the part behaves as a built-in device so the solver runs that device's real physics. `definition` is the built-in device id (e.g. 'resistor'); `terminals` maps each of that device's terminal names to one of this part's pin ids. The runtime validator additionally checks every mapped pin id actually exists on the part.",
      "properties": {
        "definition": { "type": "string", "minLength": 1 },
        "terminals": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": { "^[a-z][a-z0-9_]*$": { "type": "string", "minLength": 1 } },
          "additionalProperties": false
        }
      },
      "required": ["definition", "terminals"],
      "additionalProperties": false
    },
    "internal": {
      "allOf": [
        { "$ref": "#/$defs/blockCore" },
        {
          "properties": { "ports": { "minItems": 1 } },
          "$comment": "The TOP level must expose at least one port (= pin); a NESTED block may have zero ports (a sub-circuit grouped with no boundary wires is legal block data)."
        }
      ],
      "description": "Optional REAL internal circuit (slice 4b Model B): the part is built from a whole sub-circuit of real parts, in the solve-core block shape (name/origin/nodes/edges/ports). Each top-level port id must equal one of this part's pin ids 1:1 (a runtime-validator rule JSON Schema can't express). Mutually exclusive with behavesAs (enforced below)."
    },
    "parameters": {
      "type": "object",
      "description": "Optional default values — the user's own rough-but-typed scalars (amount + unit). No provenance required at project/user_local origin.",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": {
          "type": "object",
          "properties": {
            "value": {
              "type": "object",
              "properties": {
                "kind": { "const": "scalar" },
                "amount": { "type": "number" },
                "unit": { "type": "string" }
              },
              "required": ["kind", "amount", "unit"],
              "additionalProperties": false
            }
          },
          "required": ["value"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["id", "name", "designatorPrefix", "pins"],
  "additionalProperties": false,
  "not": {
    "required": ["behavesAs", "internal"],
    "$comment": "A part simulates ONE way — as a single device (behavesAs) or as its internal circuit (internal), never both."
  },
  "$defs": {
    "savedBlockTest": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "pattern": "\\S" },
        "name": { "type": "string", "pattern": "\\S" },
        "cycles": { "type": "integer", "minimum": 1, "maximum": 256 },
        "inputs": {
          "type": "object",
          "maxProperties": 1024,
          "propertyNames": { "pattern": "\\S" },
          "additionalProperties": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
        },
        "expected": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1024,
          "propertyNames": { "pattern": "\\S" },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        }
      },
      "required": ["id", "name", "cycles", "inputs", "expected"],
      "additionalProperties": false,
      "description": "Digital regression expectations, not cached pass results. Runtime validation also requires unique test ids and exactly cycles samples per output; execution rechecks signal names, widths and settlement."
    },
    "point": {
      "type": "object",
      "description": "A point in the drawing's own px space; y grows downward, like the canvas.",
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "required": ["x", "y"],
      "additionalProperties": false
    },
    "strokeWidth": { "type": "number", "exclusiveMinimum": 0 },
    "fill": {
      "enum": ["none", "outline", "background"],
      "description": "KiCad's fill types: hollow, filled with the line colour, or filled with the body colour."
    },
    "graphic": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": { "const": "polyline" },
            "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
            "strokeWidth": { "$ref": "#/$defs/strokeWidth" },
            "fill": { "$ref": "#/$defs/fill" }
          },
          "required": ["kind", "points", "strokeWidth", "fill"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "rectangle" },
            "start": { "$ref": "#/$defs/point" },
            "end": { "$ref": "#/$defs/point" },
            "strokeWidth": { "$ref": "#/$defs/strokeWidth" },
            "fill": { "$ref": "#/$defs/fill" }
          },
          "required": ["kind", "start", "end", "strokeWidth", "fill"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": { "const": "circle" },
            "center": { "$ref": "#/$defs/point" },
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "strokeWidth": { "$ref": "#/$defs/strokeWidth" },
            "fill": { "$ref": "#/$defs/fill" }
          },
          "required": ["kind", "center", "radius", "strokeWidth", "fill"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "An arc through three points: it starts at start, passes mid, ends at end (KiCad's form).",
          "properties": {
            "kind": { "const": "arc" },
            "start": { "$ref": "#/$defs/point" },
            "mid": { "$ref": "#/$defs/point" },
            "end": { "$ref": "#/$defs/point" },
            "strokeWidth": { "$ref": "#/$defs/strokeWidth" },
            "fill": { "$ref": "#/$defs/fill" }
          },
          "required": ["kind", "start", "mid", "end", "strokeWidth", "fill"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Text centred on `at`; angle 90 reads bottom-to-top.",
          "properties": {
            "kind": { "const": "text" },
            "at": { "$ref": "#/$defs/point" },
            "text": { "type": "string", "pattern": "\\S" },
            "size": { "type": "number", "exclusiveMinimum": 0 },
            "angle": { "enum": [0, 90] }
          },
          "required": ["kind", "at", "text", "size"],
          "additionalProperties": false
        }
      ]
    },
    "symbolPin": {
      "type": "object",
      "description": "Where one of the part's pins is drawn. `pin` is that pin's id; `at` is its tip — the connection point, where the wire lands; `length` runs from the tip to the body.",
      "properties": {
        "pin": { "type": "string", "minLength": 1 },
        "at": { "$ref": "#/$defs/point" },
        "length": { "type": "number", "exclusiveMinimum": 0 },
        "style": { "enum": ["line", "inverted", "clock", "inverted_clock"] },
        "hideName": { "type": "boolean" },
        "hideNumber": { "type": "boolean" }
      },
      "required": ["pin", "at", "length", "style"],
      "additionalProperties": false,
      "if": {
        "properties": { "style": { "enum": ["inverted", "inverted_clock"] } },
        "required": ["style"]
      },
      "then": {
        "properties": { "length": { "minimum": 6 } },
        "$comment": "An inverted pin must be long enough to hold its 3 px-radius bubble."
      }
    },
    "symbolField": {
      "type": "object",
      "properties": { "at": { "$ref": "#/$defs/point" }, "visible": { "type": "boolean" } },
      "required": ["at", "visible"],
      "additionalProperties": false
    },
    "drawnSymbol": {
      "type": "object",
      "description": "The drawn symbol: its shapes, a spot for each pin, and where its four fields go. The runtime loader (user-symbol-validate.ts) adds rules JSON Schema can't express, and sets aside a drawing that breaks one (the part keeps everything else and draws as its plain box): (1) every pin of the part is drawn exactly once, and nothing else; (2) every pin's tip lies ON the outer edge it points out of — all left-pointing tips share the drawing's leftmost x, and nothing drawn (text aside) reaches past them — so each wire lands outside the body; (3) an arc's three points are not on one straight line; (4) a rectangle has both a width and a height; (5) the drawing has a width and a height.",
      "properties": {
        "graphics": {
          "type": "array",
          "items": { "$ref": "#/$defs/graphic" },
          "contains": {
            "type": "object",
            "properties": { "kind": { "enum": ["polyline", "rectangle", "circle", "arc"] } },
            "required": ["kind"]
          },
          "$comment": "At least one shape that isn't text — the body the pins attach to."
        },
        "pins": { "type": "array", "items": { "$ref": "#/$defs/symbolPin" } },
        "fields": {
          "type": "object",
          "properties": {
            "reference": { "$ref": "#/$defs/symbolField" },
            "value": { "$ref": "#/$defs/symbolField" },
            "footprint": { "$ref": "#/$defs/symbolField" },
            "datasheet": { "$ref": "#/$defs/symbolField" }
          },
          "required": ["reference", "value", "footprint", "datasheet"],
          "additionalProperties": false
        }
      },
      "required": ["graphics", "pins", "fields"],
      "additionalProperties": false
    },
    "blockCore": {
      "type": "object",
      "description": "The solve core of an internal circuit: real parts, wires with geometry, and external ports with their declared contracts. Presentation extras such as display faces and gate symbols are not persisted here. Enable references must name an existing port, enforced by the runtime validator.",
      "properties": {
        "version": { "const": 1 },
        "tests": {
          "type": "array",
          "maxItems": 256,
          "items": { "$ref": "#/$defs/savedBlockTest" }
        },
        "name": { "type": "string" },
        "origin": {
          "type": "object",
          "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
          "required": ["x", "y"],
          "additionalProperties": false
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "definition": { "type": "string", "minLength": 1 },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "rotation": { "type": "number" },
              "parameters": {
                "type": "object",
                "patternProperties": {
                  "^[a-z][a-z0-9_]*$": {
                    "type": "object",
                    "properties": {
                      "value": {
                        "anyOf": [
                          { "type": "string", "minLength": 1 },
                          {
                            "type": "object",
                            "properties": {
                              "kind": { "const": "scalar" },
                              "amount": { "type": "number" },
                              "unit": { "type": "string" }
                            },
                            "required": ["kind", "amount", "unit"],
                            "additionalProperties": false
                          }
                        ]
                      }
                    },
                    "required": ["value"],
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              },
              "block": { "$ref": "#/$defs/blockCore" }
            },
            "required": ["id", "definition", "x", "y"],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "source": { "type": "string" },
              "sourceHandle": { "type": ["string", "null"] },
              "target": { "type": "string" },
              "targetHandle": { "type": ["string", "null"] },
              "waypoints": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "x": { "type": "number" },
                    "y": { "type": "number" }
                  },
                  "required": ["id", "x", "y"],
                  "additionalProperties": false
                }
              },
              "curved": { "const": true },
              "curveRadius": { "type": "number" }
            },
            "required": ["id", "source", "sourceHandle", "target", "targetHandle"],
            "additionalProperties": false
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "name": { "type": "string" },
              "side": { "enum": ["left", "right", "top", "bottom"] },
              "kind": { "enum": ["signal", "power_positive", "power_negative"] },
              "drive": { "enum": ["input", "push_pull", "open_collector", "tristate"] },
              "domain": {
                "enum": ["electrical", "thermal", "magnetic", "mechanical", "control", "digital"]
              },
              "direction": { "enum": ["input", "output", "bidirectional", "unknown"] },
              "role": { "enum": ["source", "load", "passive", "unknown"] },
              "unit": {
                "enum": [
                  "unknown",
                  "boolean",
                  "dimensionless",
                  "volt",
                  "ampere",
                  "ohm",
                  "watt",
                  "farad",
                  "henry",
                  "second",
                  "hertz",
                  "degree_celsius"
                ]
              },
              "enable": {
                "type": "object",
                "properties": {
                  "pin": { "type": "string", "minLength": 1 },
                  "activeHigh": { "type": "boolean" }
                },
                "required": ["pin", "activeHigh"],
                "additionalProperties": false
              },
              "inner": {
                "type": "object",
                "properties": {
                  "nodeId": { "type": "string", "minLength": 1 },
                  "handleId": { "type": "string", "minLength": 1 }
                },
                "required": ["nodeId", "handleId"],
                "additionalProperties": false
              }
            },
            "required": ["id", "label", "side", "inner"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "origin", "nodes", "edges", "ports"],
      "additionalProperties": false
    }
  }
}
